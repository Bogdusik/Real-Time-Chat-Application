# Copy to .env for docker compose, or export these before ./mvnw spring-boot:run.
# Every value has a local default; set your own password for anything beyond a local machine.

# PostgreSQL container (docker compose)
POSTGRES_DB=chatdb
POSTGRES_USER=chatuser
POSTGRES_PASSWORD=change-me

# Spring Boot backend
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/chatdb
DB_USERNAME=chatuser
DB_PASSWORD=change-me
JPA_DDL_AUTO=update
# Comma-separated; patterns such as http://localhost:* are accepted
CORS_ALLOWED_ORIGINS=http://localhost:3000

# React frontend (read at build time)
REACT_APP_API_URL=http://localhost:8080
